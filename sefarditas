function updateMapMode() {
  const range = $("mapMode").value === "range";

  // Single-year mode: show ONLY "Ano".
  // Range mode: show ONLY "Desde" and "Até".
  $("mapSingleWrap").hidden = range;
  $("mapFromWrap").hidden = !range;
  $("mapToWrap").hidden = !range;

  $("mapYear").disabled = range;
  $("mapFrom").disabled = !range;
  $("mapTo").disabled = !range;

  if (range && +$("mapFrom").value > +$("mapTo").value) {
    $("mapTo").value = $("mapFrom").value;
  }
  renderMap();
}

function initMapControls() {
  // MAP ONLY: the selectors must contain real year values only.
  // Never expose null/undefined/non-year values returned by the API.
  const mapYears = D.years.slice(0, 10);

  if (!mapYears.length) {
    $("map").innerHTML = `<div class="empty">${t("err")}</div>`;
    return;
  }

  const opts = mapYears.map(y => `<option value="${y}">${y}</option>`).join("");
  $("mapYear").innerHTML = opts;
  $("mapFrom").innerHTML = opts;
  $("mapTo").innerHTML = opts;

  $("mapYear").value = String(mapYears[mapYears.length - 1]);
  $("mapFrom").value = String(mapYears[0]);
  $("mapTo").value = String(mapYears[mapYears.length - 1]);

  $("mapMode").addEventListener("change", updateMapMode);
  updateMapMode();
  $("mapYear").addEventListener("change", renderMap);
  $("mapFrom").addEventListener("change", renderMap);
  $("mapTo").addEventListener("change", renderMap);
}


