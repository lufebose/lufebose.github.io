<style>
:root{--bg:#f3f6f9;--ink:#10243a;--mut:#5d6f82;--line:#d3dce6;--h:#2358a6;--m:#d38b1f;--surf:#fff}
@media(prefers-color-scheme:dark){:root{--bg:#0d1824;--ink:#e6edf5;--mut:#92a4b8;--line:#25384d;--h:#6f9fe6;--m:#e8a94a;--surf:#132233}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 'Instrument Sans',system-ui,sans-serif;padding:0 20px 48px}
main{max-width:1100px;margin:0 auto}
header{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;padding:36px 0 20px;border-bottom:2px solid var(--ink)}
h1{font:600 clamp(26px,4.5vw,42px)/1.1 Fraunces,Georgia,serif;margin:0;max-width:22ch}
p.sub{margin:6px 0 0;color:var(--mut)}
button,select,input{font:inherit;color:var(--ink);background:var(--surf);border:1px solid var(--line);border-radius:6px;padding:6px 10px}
button{cursor:pointer}
button:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid var(--h);outline-offset:2px}
.bar{display:flex;flex-wrap:wrap;gap:14px;padding:16px 0}
.bar label{display:flex;flex-direction:column;font-size:13px;color:var(--mut);gap:3px}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));border-block:1px solid var(--line)}
.kpi{padding:16px 16px 16px 0}
.kpi b{display:block;font:600 34px/1.1 Fraunces,Georgia,serif}
.kpi span{color:var(--mut);font-size:13px}
.charts{display:grid;grid-template-columns:3fr 2fr;gap:28px;margin:28px 0}
@media(max-width:800px){.charts{grid-template-columns:1fr}}
h2{font:600 18px Fraunces,Georgia,serif;margin:0 0 10px}
.cv{position:relative;height:300px}
.tools{display:flex;justify-content:space-between;align-items:end;gap:12px;flex-wrap:wrap;margin-bottom:10px}
.wrap{overflow-x:auto;border:1px solid var(--line);background:var(--surf);max-height:560px}
table{border-collapse:collapse;width:100%;font-variant-numeric:tabular-nums}
th,td{padding:5px 9px;text-align:right;white-space:nowrap}
th{position:sticky;top:0;background:var(--surf);cursor:pointer;border-bottom:1px solid var(--line);user-select:none}
th:first-child,td:first-child{text-align:left;position:sticky;left:0;background:var(--surf)}
td.tot{font-weight:600}
#msg{color:var(--mut);padding:24px 0}
.map-section{margin:30px 0 34px}
.map-note{margin:2px 0 0;color:var(--mut);font-size:13px}.source{margin:4px 0 0;color:var(--mut);font-size:12px}.map-year[hidden]{display:none!important}.source a{color:inherit}
.map-controls{display:flex;gap:10px;flex-wrap:wrap}
.map-year{display:flex;flex-direction:column;gap:3px;font-size:12px;color:var(--mut)}
.top-section{min-width:0}
.top-list{height:300px;overflow-y:auto;border:1px solid var(--line);background:var(--surf);border-radius:8px;padding:10px 12px}
.top-row{display:grid;grid-template-columns:minmax(150px,1fr) 1fr auto;align-items:center;gap:10px;padding:7px 4px;border-bottom:1px solid var(--line);font-size:13px}
.top-row:last-child{border-bottom:0}
.top-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.top-track{height:9px;background:var(--bg);border-radius:10px;overflow:hidden}
.top-fill{height:100%;background:var(--h);border-radius:10px}
.top-value{font-variant-numeric:tabular-nums;font-weight:600;min-width:70px;text-align:right}
.table-head-tools{display:flex;align-items:end;gap:12px;flex-wrap:wrap}
.map-controls label{display:flex;flex-direction:column;gap:3px;font-size:12px;color:var(--mut)}
#map{height:520px;border:1px solid var(--line);background:var(--surf);border-radius:8px;overflow:hidden}
#map svg{display:block;width:100%;height:100%}
.country{stroke:var(--surf);stroke-width:.55px;cursor:pointer}
.country:hover{stroke:var(--ink);stroke-width:1.2px}
.map-footnote{margin:6px 0 0;color:var(--mut);font-size:12px}.map-legend{display:flex;align-items:center;gap:8px;margin-top:8px;color:var(--mut);font-size:12px}
.map-legend i{width:180px;height:10px;border-radius:8px;background:linear-gradient(90deg,#eef4fb,#2358a6);display:block}
.continent{margin:26px 0 0}
.continent h3{font:600 20px Fraunces,Georgia,serif;margin:0 0 10px;padding-bottom:7px;border-bottom:1px solid var(--line)}
.continent-card{border:1px solid var(--line);background:var(--surf);border-radius:8px;overflow:hidden}
.continent-card .wrap{border:0;max-height:360px}
@media(max-width:650px){#map{height:380px}}
