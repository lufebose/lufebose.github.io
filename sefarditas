<script>
// 1) Paste your Apps Script web app URL (ends in /exec)
const API = "https://script.google.com/macros/s/AKfycbwRC85CF1_6bboHoECH1N8gXJboWwRSBl1f9ugMVayZgh8ID4WPBErsLNRmPbB4YwB3/exec";
// 2) Rows in "Nacionalidade anterior" that are totals/groups and must not be summed (lowercase)
// Rows that are NOT countries/nationalities. These are aggregate regions,
// continental totals, EU aggregates, or grand totals and must NEVER appear
// in the country table, TOP list, KPIs, charts, or map values.
const AGG = [
  "total",
  "asia", "ásia", "africa", "áfrica", "america", "américa",
  "europe", "europa", "oceania", "oceânia",
  "north america", "south america",
  "norte america", "norte américa", "sul america", "sul américa",
  "middle east", "medio oriente", "médio oriente",
  "uniao europeia", "união europeia", "european union",
  "eu - 27", "ue - 27", "eu27", "ue27",
  "extra ue", "extra eu",
  "estrangeiro", "foreign"
];

function isAggregateName(name) {
  const n = normalizeName(name);

  // Exact aggregate labels.
  const exact = new Set(AGG.map(normalizeName));
  if (exact.has(n)) return true;

  // EU aggregate labels such as:
  // "Extra UE - 27 Estados-membros (a partir de 2020)"
  // "União Europeia 27 (a partir de 2020)"
  if (/^(extra )?(ue|eu)(\s*[-–—]?\s*\d+)?\b/.test(n)) return true;
  if (/^(uniao europeia|european union)(\s*[-–—]?\s*\d+)?\b/.test(n)) return true;

  // Any explicitly labelled regional/continental aggregate.
  if (/^(asia|africa|america|europe|europa|oceania)(\s+total)?$/.test(n)) return true;
  if (/^(north america|south america|norte america|sul america)$/.test(n)) return true;
  if (/^(middle east|medio oriente|medio oriente)$/.test(n)) return true;

  return false;
}

const T = {
 pt:{title:"Aquisições de nacionalidade portuguesa",sub:"Por sexo, local de residência e nacionalidade anterior",from:"Desde",to:"Até",sex:"Sexo",res:"Residência",all:"Todos",H:"Homens",M:"Mulheres",Total:"Total",Estrangeiro:"Estrangeiro",Portugal:"Portugal",trend:"Evolução anual",top:"Principais nacionalidades anteriores",heat:"Nacionalidade × ano",csv:"Exportar CSV",search:"Procurar nacionalidade…",nat:"Nacionalidade",tot:"Total",k1:"Aquisições no período",k2:"Variação último ano",k3:"Ano de pico",k4:"Nacionalidades com registos",loading:"A carregar…",err:"Não foi possível carregar os dados. Verifique o URL do Apps Script.",map:"Mapa por país",mapNote:"A intensidade mostra o total de aquisições no ano selecionado. Passe o rato sobre um país.",mapIsraelNote:"Nota: Israel é destacado a amarelo no mapa.",mapYear:"Ano",mapMode:"Visualização",mapSingle:"Ano único",mapRange:"Intervalo de anos",mapFrom:"Desde",mapTo:"Até",continent:"Continente",low:"Menor",high:"Maior",ASIA:"ÁSIA",EUROPE:"EUROPA",AMERICA:"AMÉRICA",AFRICA:"ÁFRICA",OCEANIA:"OCEÂNIA",OTHER:"OUTROS"},
 en:{title:"Portuguese nationality acquisitions",sub:"By sex, place of residence and previous nationality",from:"From",to:"To",sex:"Sex",res:"Residence",all:"All",H:"Men",M:"Women",Total:"Total",Estrangeiro:"Abroad",Portugal:"Portugal",trend:"Yearly trend",top:"Top previous nationalities",heat:"Nationality × year",csv:"Export CSV",search:"Search nationality…",nat:"Nationality",tot:"Total",k1:"Acquisitions in period",k2:"Last-year change",k3:"Peak year",k4:"Nationalities with records",loading:"Loading…",err:"Could not load the data. Check the Apps Script URL.",map:"Country heatmap",mapNote:"Intensity shows total acquisitions in the selected year. Hover over a country for details.",mapIsraelNote:"Note: Israel is highlighted in yellow on the map.",mapYear:"Year",mapMode:"View",mapSingle:"Single year",mapRange:"Year range",mapFrom:"From",mapTo:"To",continent:"Continent",low:"Lower",high:"Higher",ASIA:"ASIA",EUROPE:"EUROPE",AMERICA:"AMERICA",AFRICA:"AFRICA",OCEANIA:"OCEANIA",OTHER:"OTHER"}
};
let lang = localStorage.getItem("lang") || (navigator.language.startsWith("pt") ? "pt" : "en");
let D, sortK = "tot", sortD = -1, ch = {}, view = [];
const $ = id => document.getElementById(id), t = k => T[lang][k] || k;
const fmt = n => n.toLocaleString(lang === "pt" ? "pt-PT" : "en-GB");
const css = v => getComputedStyle(document.documentElement).getPropertyValue(v).trim();

async function load() {
  $("msg").textContent = t("loading");
  try {
    const j = await (await fetch(API)).json();
    const apiYears = (j.years || [])
      .map(Number)
      .filter(y => Number.isInteger(y) && y >= 2016 && y <= 2025);

    // Source format is:
    // [Sexo, Residência, Nacionalidade anterior, 2016 ... 2025, ISO3]
    // ISO3 is the LAST field. Keep this independent of any extra/null API fields.
    D = {
      years: apiYears,
      rows: (j.rows || [])
        .map(r => {
          const yearCount = apiYears.length;
          const iso3 = String(r[r.length - 1] ?? "").trim().toUpperCase();
          const values = r.slice(3, 3 + yearCount).map(x => {
            const n = typeof x === "number"
              ? x
              : Number(String(x ?? "").replace(/\s/g, "").replace(",", "."));
            return Number.isFinite(n) ? n : 0;
          });
          return {
            s: String(r[0] ?? "").trim(),
            r: String(r[1] ?? "").trim(),
            n: String(r[2] ?? "").trim(),
            v: values,
            iso3
          };
        })
        .filter(r => !isAggregateName(r.n))
    };
    const ys = D.years.map(y => `<option>${y}</option>`).join("");
    $("y0").innerHTML = ys; $("y1").innerHTML = ys;
    $("y0").value = D.years[0]; $("y1").value = D.years.at(-1);
    D.sexes = [...new Set(D.rows.map(r => r.s))]; D.res = [...new Set(D.rows.map(r => r.r))];
    $("msg").hidden = true; $("app").hidden = false;
    labels(); initMapControls(); render();
  } catch (e) { $("msg").textContent = t("err"); }
}

function labels() {
  document.documentElement.lang = lang;
  $("title").textContent = t("title"); $("sub").textContent = t("sub");
  $("lang").textContent = lang === "pt" ? "EN" : "PT";
  document.title = t("title");
  document.querySelectorAll("[data-t]").forEach(e => e.textContent = t(e.dataset.t));
  $("q").placeholder = t("search");
  if (!D) return;
  const sx = $("sx").value || "all", rs = $("rs").value || (D.res.includes("Total") ? "Total" : D.res[0]);
  const continent = $("continentFilter")?.value || "ALL";
  $("sx").innerHTML = `<option value="all">${t("all")}</option>` + D.sexes.map(s => `<option value="${s}">${t(s)}</option>`).join("");
  $("rs").innerHTML = D.res.map(s => `<option value="${s}">${t(s)}</option>`).join("");
  $("sx").value = sx; $("rs").value = rs;
  if ($("continentFilter")) {
    $("continentFilter").innerHTML = `<option value="ALL">${t("all")}</option>` +
      ["ASIA","EUROPE","AMERICA","AFRICA","OCEANIA","OTHER"].map(c => `<option value="${c}">${t(c)}</option>`).join("");
    $("continentFilter").value = continent;
  }
}

function render() {
  const y0 = +$("y0").value, y1 = +$("y1").value, sx = $("sx").value, rs = $("rs").value;
  const ys = D.years.filter(y => y >= y0 && y <= y1), ix = ys.map(y => D.years.indexOf(y));
  const continent = $("continentFilter").value || "ALL";
  // Global continent filter: it affects KPIs, yearly trend, Top nationalities and table.
  const rows = D.rows.filter(r =>
    r.r === rs &&
    (sx === "all" || r.s === sx) &&
    (continent === "ALL" || continentOf(r.n) === continent)
  );
  const bs = {}, nat = {};
  D.sexes.forEach(s => bs[s] = ys.map(() => 0));
  rows.forEach(r => {
    nat[r.n] ??= ys.map(() => 0);
    ix.forEach((j, k) => { bs[r.s][k] += r.v[j]; nat[r.n][k] += r.v[j]; });
  });
  const tot = ys.map((_, k) => D.sexes.reduce((a, s) => a + bs[s][k], 0));
  const sum = a => a.reduce((x, y) => x + y, 0);
  const n = tot.length, last = tot[n - 1], prev = tot[n - 2];
  const chg = prev ? ((last - prev) / prev * 100) : null;
  const peak = ys[tot.indexOf(Math.max(...tot))];
  const list = Object.entries(nat)
    .map(([k, v]) => ({ n: k, v, tot: sum(v) }))
    .filter(e => e.tot > 0 && !isAggregateName(e.n));
  $("kpis").innerHTML = [[t("k1"), fmt(sum(tot))],
    [t("k2") + (n > 1 ? ` (${ys[n - 1]})` : ""), chg === null ? "–" : (chg > 0 ? "+" : "") + chg.toFixed(1).replace(".", lang === "pt" ? "," : ".") + "%"],
    [t("k3"), peak], [t("k4"), fmt(list.length)]]
    .map(([l, v]) => `<div class="kpi"><b>${v}</b><span>${l}</span></div>`).join("");

  Chart.defaults.color = css("--mut"); Chart.defaults.font.family = "Instrument Sans, system-ui, sans-serif";
  const grid = { color: css("--line") };
  ch.a?.destroy();
  const col = { H: css("--h"), M: css("--m") };
  ch.a = new Chart($("c1"), { type: "bar",
    data: { labels: ys, datasets: D.sexes.map(s => ({ label: t(s), data: bs[s], backgroundColor: col[s] || "#888" })) },
    options: { maintainAspectRatio: false, scales: { x: { stacked: true, grid: { display: false } }, y: { stacked: true, grid } } } });
  // Top nationalities is a scrollable ranking, so the user can browse beyond the first 10.
  const top = [...list].sort((a, b) => b.tot - a.tot);
  const topMax = Math.max(1, ...top.map(e => e.tot));
  $("topList").innerHTML = top.length ? top.map((e, i) => `
    <div class="top-row">
      <div class="top-name">${i + 1}. ${e.n}</div>
      <div class="top-track"><div class="top-fill" style="width:${Math.max(1, e.tot / topMax * 100)}%"></div></div>
      <div class="top-value">${fmt(e.tot)}</div>
    </div>`).join("") : `<div class="empty">${t("err")}</div>`;

  view = { ys, list, continent }; table();
}

function table() {
  const { ys, list, continent } = view;
  const q = $("q").value.toLowerCase();

  const filtered = list
    .filter(e => !isAggregateName(e.n))
    .filter(e => e.n.toLowerCase().includes(q))
    .sort((a, b) =>
      sortK === "n" ? sortD * -a.n.localeCompare(b.n) :
      sortD * ((sortK === "tot" ? a.tot : a.v[sortK]) - (sortK === "tot" ? b.tot : b.v[sortK])));

  const max = Math.max(1, ...list.flatMap(e => e.v));
  const filterLabel = continent === "ALL" ? t("all") : t(continent);
  if ($("tableFilterLabel")) $("tableFilterLabel").textContent = `${t("continent")}: ${filterLabel}`;
  const heat = v => v ? `style="background:color-mix(in srgb,${css("--h")} ${Math.round(Math.sqrt(v / max) * 80)}%,transparent)"` : "";

  $("continentSections").innerHTML = `<div class="continent-card"><div class="wrap">
    <table id="tb"><thead><tr>
      <th data-k="n">${t("nat")}</th>
      ${ys.map((y,i)=>`<th data-k="${i}">${y}</th>`).join("")}
      <th data-k="tot">${t("tot")}</th>
    </tr></thead>
    <tbody>
      ${filtered.map(e => `<tr><td>${e.n}</td>${e.v.map(v=>`<td ${heat(v)}>${fmt(v)}</td>`).join("")}<td class="tot">${fmt(e.tot)}</td></tr>`).join("")}
    </tbody></table>
  </div></div>`;

  view.rows = filtered;

  document.querySelectorAll("#tb th[data-k]").forEach(th => {
    th.addEventListener("click", () => {
      const k = th.dataset.k === "n" || th.dataset.k === "tot" ? th.dataset.k : +th.dataset.k;
      sortD = sortK === k ? -sortD : -1;
      sortK = k;
      table();
    });
  });

  renderMap();
}

