function normalizeName(s) {
  return String(s || "").trim().toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/[^a-z0-9]+/g," ");
}
function continentOf(name) {
  if (isAggregateName(name)) return "OTHER";
  const n = normalizeName(name);
  for (const [c, arr] of Object.entries(CONTINENT_GROUPS)) {
    if (arr.some(x => normalizeName(x) === n)) return c;
  }
  return "OTHER";
}

